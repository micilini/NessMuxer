# Resolve only optional backends requested by the consumer. No network access.
function(ness_bundled_encoders)
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/native-backends.lock.json" lock)
    if(NESS_USE_X264_V2 AND NOT NESS_X264_V2_INCLUDE_DIR)
        foreach(header IN ITEMS x264.h x264_config.h)
            string(JSON expected GET "${lock}" x264 headers ${header})
            file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/third_party/x264-abi164/include/${header}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Bundled x264 header hash mismatch: ${header}")
            endif()
        endforeach()
        set(NESS_X264_V2_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/x264-abi164/include" CACHE PATH "Matching x264 ABI164 headers" FORCE)
    endif()
    if(NESS_USE_QSV_V2 AND NOT NESS_VPL_SOURCE_DIR)
        string(JSON expected GET "${lock}" libvpl sha256)
        set(archive "${CMAKE_CURRENT_SOURCE_DIR}/third_party/libvpl-2.17.0.source.zip")
        file(SHA256 "${archive}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Bundled VPL source archive hash mismatch")
        endif()
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/vendor")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/vendor")
        set(NESS_VPL_SOURCE_DIR "${CMAKE_CURRENT_BINARY_DIR}/vendor/libvpl-2.17.0" CACHE PATH "Intel VPL dispatcher source" FORCE)
    endif()
    foreach(sdk IN ITEMS nvenc amf)
        string(TOUPPER "${sdk}" name)
        if(NESS_USE_${name}_V2)
            string(JSON count LENGTH "${lock}" ${sdk} files)
            math(EXPR last "${count}-1")
            foreach(index RANGE 0 ${last})
                string(JSON relative MEMBER "${lock}" ${sdk} files ${index})
                string(JSON expected GET "${lock}" ${sdk} files "${relative}")
                file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${relative}" actual)
                if(NOT actual STREQUAL expected)
                    message(FATAL_ERROR "Bundled ${sdk} header/notice hash mismatch: ${relative}")
                endif()
            endforeach()
        endif()
    endforeach()
endfunction()
